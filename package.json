{
  "name": "printaichat",
  "version": "1.0.0",
  "description": "Browser extension for clean AI chat printing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.js --watch --browser=chrome",
    "build": "node scripts/validate-manifest.js && node scripts/build.js --browser=all",
    "build:chrome": "node scripts/validate-manifest.js && node scripts/build.js --browser=chrome",
    "build:edge": "node scripts/validate-manifest.js && node scripts/build.js --browser=edge",
    "zip": "node scripts/validate-manifest.js && node scripts/build.js --browser=all --zip",
    "zip:chrome": "node scripts/validate-manifest.js && node scripts/build.js --browser=chrome --zip",
    "zip:edge": "node scripts/validate-manifest.js && node scripts/build.js --browser=edge --zip",
    "validate": "node scripts/validate-manifest.js",
    "icons": "node scripts/generate-icons.js",
    "lint": "eslint src/ scripts/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "archiver": "^7.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.1.0",
    "sharp": "^0.34.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
